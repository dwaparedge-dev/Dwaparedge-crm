# Copy to .env.local (or .env) and fill in. Never commit real values.

# ---- Database: plain PostgreSQL (Supabase is only the Postgres host) ----
# Used by the running app. Locally the Supabase *session* pooler (port 5432) is fine. On Vercel use the *transaction* pooler
# (same host, port 6543): the session pooler allows only 15 connections in total and serverless instances exhaust it
# (EMAXCONNSESSION: every page fails). Then put the session-pooler URL in DIRECT_URL below for db:sync / db:migrate.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional. If set, `npm run db:sync`, `npm run db:migrate` and the admin scripts use this instead of DATABASE_URL.
# Leave it unset unless you have a separate direct connection; a placeholder here will break migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Most connections one server instance may hold open (default 10). instances x this must stay under the pooler's limit:
# the session pooler allows 15 in total, the transaction pooler (port 6543) far more. Lower it if you see EMAXCONNSESSION.
DB_POOL_MAX=

# ---- Auth (users table + bcrypt + signed JWT in an httpOnly cookie) ----
# Required. At least 32 characters. Generate: openssl rand -hex 48
JWT_SECRET=
# How long a sign-in lasts. 1 is a good production value; people also sign out automatically after 30 idle minutes.
JWT_EXPIRES_IN_DAYS=1
BCRYPT_SALT_ROUNDS=12

# Salt for hashing emails/IPs in the login rate limiter. Required in production. Generate: openssl rand -hex 16
RATE_LIMIT_SALT=

# ---- Demo requests from the FactoOne landing page ----
# Shared secret the FactoOne server sends in the X-Intake-Key header. At least 32 characters; use a different one in
# production. Generate: openssl rand -hex 32. Leave blank to switch the endpoint off (it then answers 503).
DEMO_INTAKE_KEY=

# ---- Website analytics ----
# Raw visitor data is erased after this many days (default 395 = 13 months). Run `npm run analytics:purge` daily (see docs/SECURITY.md).
ANALYTICS_RETENTION_DAYS=

# ---- First administrator, created once by `npm run db:seed-admin` ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---- Auto-raised tasks ----
# Leave blank to keep them off. Set to a date (YYYY-MM-DD): only records dated on or after it get a task automatically.
TASKS_AUTO_FROM=
