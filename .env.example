# Copy to .env.local (or .env) and fill in. Never commit real values.

# ---- Database: plain PostgreSQL (Supabase is only the Postgres host) ----
# Used by the running app. On Vercel use the Supabase *session* pooler (port 5432) or the direct URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional. If set, `npm run db:migrate` and the admin scripts use this instead of DATABASE_URL.
# Leave it unset unless you have a separate direct connection; a placeholder here will break migrations.
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Auth (users table + bcrypt + signed JWT in an httpOnly cookie) ----
# Required. At least 32 characters. Generate: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
BCRYPT_SALT_ROUNDS=12

# Salt for hashing emails/IPs in the login rate limiter. Generate: openssl rand -hex 16
RATE_LIMIT_SALT=

# ---- First administrator, created once by `npm run db:seed-admin` ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
